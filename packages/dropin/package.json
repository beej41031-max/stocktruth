{
  "name": "@stocktruth/dropin",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Shopify against a 3PL report, in one HTML file. Runs in the browser, makes no network requests.",
  "scripts": {
    "demo-data": "tsx demo/make-demo.ts",
    "build": "node build.mjs",
    "test": "tsx --test test/report.test.ts test/analyse.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stocktruth/engine": "*",
    "@stocktruth/adapter-shopify": "*"
  },
  "devDependencies": {
    "esbuild": "*",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "@types/node": "^22.20.3"
  }
}

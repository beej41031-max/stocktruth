{
  "name": "@stocktruth/adapter-csv",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },

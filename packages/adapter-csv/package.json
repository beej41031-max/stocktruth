    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stocktruth/engine": "*"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "@types/node": "^22.20.3"
  }
}

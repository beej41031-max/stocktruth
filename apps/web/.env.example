# Database connection used by the server only. Never expose this as NEXT_PUBLIC_*.
#
# Local dev: Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Vercel:    Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
# Copy the full URI from Supabase; do not guess the pooler host. Add sslmode=require.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require

# Demo-only identity. The seed creates this user and gives it owner access.
# Real auth is deliberately outside v0.1.
DEMO_USER_ID=11111111-1111-4111-8111-000000000001
